{
  "manifest_version": 3,
  "name": "Hockage Ink Overlay",
  "version": "0.1.0",
  "description": "Lớp vẽ thử nghiệm độc lập trên trang web.",
  "permissions": ["activeTab", "scripting"],
  "action": { "default_title": "Hockage Ink", "default_popup": "popup.html" },
  "web_accessible_resources": [{
    "resources": ["overlay.html"],
    "matches": ["http://*/*", "https://*/*"]
  }]
}
